# Image tag used by compose.yaml. Keep `latest` for the most recent release.
REKO_TAG=latest

# Port exposed on the host.
REKO_PORT=8000

# Number of generation jobs processed concurrently. Keep this at 1 on modest hosts.
REKO_MAX_CONCURRENT_JOBS=1

# Optional UID/GID used by the container for bind-mounted data. Set these to
# your host user's values when ./data is managed outside Docker.
# REKO_UID=1000
# REKO_GID=1000
